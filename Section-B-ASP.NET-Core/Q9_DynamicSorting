
using System.Linq.Expressions;
using Microsoft.EntityFrameworkCore;

public static class QuerySorting
{
    public static IQueryable<T> OrderBy<T>(
        this IQueryable<T> query,
        string sortExpression,
        IReadOnlyDictionary<string, Expression<Func<T, object>>> allowedColumns)
    {
        if (string.IsNullOrWhiteSpace(sortExpression))
            throw new ArgumentException("Sort expression is required.");

        var parts = sortExpression.Trim().Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length < 1 || parts.Length > 2)
            throw new ArgumentException("Invalid sort expression.");

        var column = parts[0];

        if (!allowedColumns.TryGetValue(column, out var selector))
            throw new ArgumentException("Invalid sort column.");

        var direction = parts.Length == 2 ? parts[1] : "asc";

        if (direction.Equals("asc", StringComparison.OrdinalIgnoreCase))
            return query.OrderBy(selector);

        if (direction.Equals("desc", StringComparison.OrdinalIgnoreCase))
            return query.OrderByDescending(selector);

        throw new ArgumentException("Invalid sort direction.");
    }
}

public class Product
{
    public long Id { get; set; }
    public string Name { get; set; } = "";
    public decimal Price { get; set; }
    public DateTime CreatedAt { get; set; }
}

public static class ProductSorting
{
    public static readonly IReadOnlyDictionary<string, Expression<Func<Product, object>>>
        AllowedColumns = new Dictionary<string, Expression<Func<Product, object>>>(
            StringComparer.OrdinalIgnoreCase)
        {
            ["Id"] = x => x.Id,
            ["Name"] = x => x.Name,
            ["Price"] = x => x.Price,
            ["CreatedAt"] = x => x.CreatedAt
        };
}

public class ProductService
{
    private readonly AppDbContext _dbContext;

    public ProductService(AppDbContext dbContext)
    {
        _dbContext = dbContext;
    }

    public async Task<List<Product>> GetProductsAsync(
        string? sortExpression,
        CancellationToken cancellationToken)
    {
        var query = _dbContext.Products.AsNoTracking();

        if (!string.IsNullOrWhiteSpace(sortExpression))
        {
            query = query.OrderBy(
                sortExpression,
                ProductSorting.AllowedColumns);
        }

        return await query.ToListAsync(cancellationToken);
    }
}
